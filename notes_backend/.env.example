# Optional environment variables for Notes Backend

# Custom application version shown in OpenAPI
APP_VERSION=1.0.0

# Database configuration
# If not set, defaults to SQLite file at data/notes.db
# DATABASE_URL=sqlite:///data/notes.db
# NOTES_DB_DIR=data
# NOTES_DB_FILE=notes.db

# CORS allowed origins (comma-separated). Defaults to "*"
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
